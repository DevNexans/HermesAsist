# API key de tu proveedor LLM (NVIDIA por defecto: https://build.nvidia.com)
HERMES_API_KEY=tu_clave_aqui

# Base URL del proveedor (compatible con OpenAI)
#   NVIDIA:  https://integrate.api.nvidia.com/v1   (por defecto)
#   Groq:    https://api.groq.com/openai/v1
#   OpenAI:  https://api.openai.com/v1
# HERMES_BASE_URL=https://integrate.api.nvidia.com/v1

# Modelo inicial (por defecto nvidia/nemotron-3-super-120b-a12b)
# HERMES_MODEL=nvidia/nemotron-3-super-120b-a12b

# Opcional: tamaño del modelo Whisper local (tiny|base|small|medium)
# HERMES_WHISPER_MODEL=small

# Opcional: dispositivo de micrófono (nombre o índice de sounddevice)
# HERMES_MIC_DEVICE=Audio Interno

# Opcional: directorio de datos de Hermes (por defecto ~/.hermes)
# HERMES_HOME=/ruta/a/datos
